# Required
ANTHROPIC_API_KEY=sk-ant-...

# Storage mode: "env" = use SKILLMASTER_GCS_BUCKET directly, "db" = multi-tenant NeonDB lookup
SKILLMASTER_STORAGE_MODE=env

# GCS Storage (used when SKILLMASTER_STORAGE_MODE=env)
SKILLMASTER_GCS_BUCKET=skillmaster-skills
SKILLMASTER_GCS_PROJECT=your-gcp-project-id

# NeonDB (required when SKILLMASTER_STORAGE_MODE=db)
NEONDB_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/skillmaster

# Service
SKILLMASTER_PORT=8080
SKILLMASTER_LOG_LEVEL=INFO
